#!/bin/sh
# Launcher: runs the CLI on the fastest runtime available, from any directory.
# Symlink it onto your PATH, e.g.
#   ln -s "$PWD/bin/goso" ~/.local/bin/goso
#
# bun is preferred over node — the work is short enough that interpreter startup
# is most of it, and bun starts in about a quarter of the time. The sources are
# plain node: APIs, so both produce the same output; node is the fallback so a
# fresh clone works without installing bun.
#
# Callers such as Raycast spawn this with a minimal PATH that has none of these
# on it, so each is also looked for where it is usually installed.
set -e

resolve_link() {
  # `readlink -f` is not portable to older macOS; walk the symlinks by hand.
  link=$1
  while [ -L "$link" ]; do
    target=$(readlink "$link")
    case $target in
      /*) link=$target ;;
      *) link=$(dirname "$link")/$target ;;
    esac
  done
  printf '%s\n' "$link"
}

SELF=$(resolve_link "$0")
ROOT=$(CDPATH= cd -- "$(dirname -- "$SELF")/.." && pwd)
ENTRY="$ROOT/packages/cli/src/main.ts"

find_tool() {
  name=$1
  if command -v "$name" >/dev/null 2>&1; then
    command -v "$name"
    return 0
  fi
  for dir in "$HOME/.local/bin" /opt/homebrew/bin /usr/local/bin; do
    if [ -x "$dir/$name" ]; then
      printf '%s\n' "$dir/$name"
      return 0
    fi
  done
  return 1
}

# GOSO_RUNTIME pins the interpreter, for reproducing a runtime-specific problem.
RUNTIMES=${GOSO_RUNTIME:-"bun node"}

# mise knows the versions this project pins, so ask it first — node below 24
# silently loses the Antigravity provider, and pinning is how that is avoided.
# Resolve to the binary and exec it directly: `mise exec` would mean a second
# mise process, and at these run times that overhead is visible.
if MISE=$(find_tool mise); then
  for runtime in $RUNTIMES; do
    if RESOLVED=$("$MISE" which --cd "$ROOT" "$runtime" 2>/dev/null) && [ -x "$RESOLVED" ]; then
      exec "$RESOLVED" "$ENTRY" "$@"
    fi
  done
fi

# No mise: whatever is on PATH. node needs >= 22.18 for TypeScript stripping,
# and >= 24 for the Antigravity provider's node:sqlite.
for runtime in $RUNTIMES; do
  if FOUND=$(find_tool "$runtime"); then
    exec "$FOUND" "$ENTRY" "$@"
  fi
done

echo "goso: no runtime found — install bun or node (or mise, which pins both)" >&2
exit 127
